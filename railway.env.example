# Paste into Railway -> your service -> Variables -> Raw Editor.
# These are the fixed values; add your own secrets underneath.
# Generated from render.yaml so the two hosts cannot drift apart.

ENVIRONMENT=production
DEBUG=False
B2_PREFIX=flux
KEEP_LOCAL_COPY=false
GENBLAZE_ENABLED=true
GENBLAZE_TENANT_ID=flux
GENBLAZE_EMBED_MANIFEST=true
YOUTUBE_PRIVACY_STATUS=private
TRENDS_ENABLED=true
TRENDS_AUTO_PUBLISH=false
CONTENT_PROFILE=finance
INGEST_MAX_MB=250
KEEPALIVE_ENABLED=true
KEEPALIVE_MINUTES=12
FLUX_FFMPEG_THREADS=2
FLUX_FFMPEG_PRESET=ultrafast
FLUX_VIDEO_WIDTH=480
FLUX_VIDEO_HEIGHT=854
DEFAULT_VIDEO_FPS=15
TRENDS_TOP_N=1

# --- secrets: fill these in yourself -------------------------------
GEMINI_API_KEY=
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_REGION=
GMI_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
GEMINI_API_KEYS=
CORS_ORIGINS=
YOUTUBE_TOKEN_JSON=
YOUTUBE_DEFAULT_CHANNEL_TITLE=
FLUX_SECRET_KEY=
